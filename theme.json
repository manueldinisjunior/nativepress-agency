{
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "name": "2X Small", "size": "0.5rem" },
        { "slug": "30", "name": "Small", "size": "1rem" },
        { "slug": "40", "name": "Medium", "size": "1.5rem" },
        { "slug": "50", "name": "Large", "size": "2.5rem" },
        { "slug": "60", "name": "X Large", "size": "4rem" },
        { "slug": "70", "name": "2X Large", "size": "6rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        { "slug": "poppins", "name": "Poppins", "fontFamily": "'Poppins', sans-serif" },
        { "slug": "system", "name": "System Sans", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
      ],
      "fontSizes": [
        { "slug": "extra-small", "name": "Extra Small", "size": "0.85rem" },
        { "slug": "small", "name": "Small", "size": "0.95rem" },
        { "slug": "normal", "name": "Normal", "size": "1rem" },
        { "slug": "medium", "name": "Medium", "size": "1.25rem" },
        { "slug": "large", "name": "Large", "size": "1.75rem" },
        { "slug": "x-large", "name": "XLarge", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.25rem" } },
        { "slug": "xx-large", "name": "2XLarge", "size": "3.5rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
      ]
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#1A1F3A" },
        { "slug": "accent", "name": "Accent", "color": "#27D3FF" },
        { "slug": "background", "name": "Background", "color": "#F8F7F5" },
        { "slug": "text", "name": "Text", "color": "#2D3142" },
        { "slug": "muted", "name": "Muted", "color": "#666666" },
        { "slug": "border", "name": "Border", "color": "#E8E6E1" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "surface-alt", "name": "Surface Alt", "color": "#f8fafc" }
      ],
      "gradients": [
        { "slug": "accent-soft", "name": "Accent Soft", "gradient": "linear-gradient(135deg, #27D3FF 0%, rgba(39, 211, 255, 0.15) 100%)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|poppins",
      "fontSize": "var:preset|font-size|normal",
      "lineHeight": "1.8"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "button": {
        "border": {
          "radius": "1.25rem"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "lineHeight": "1.8"
        }
      },
      "core/heading": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "core/button": {
        "border": {
          "radius": "1.25rem"
        }
      }
    }
  }
}
